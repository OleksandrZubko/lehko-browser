{
  "manifest_version": 3,
  "name": "Легко — Browser Lab",
  "version": "0.4.7",
  "description": "Блокує рекламу й трекери, звільняє пам’ять вкладок і зменшує навантаження на CPU.",
  "minimum_chrome_version": "137",
  "permissions": ["favicon", "sidePanel", "identity", "tabs", "tabGroups", "storage", "alarms", "declarativeNetRequest", "scripting", "management"],
  "optional_host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*/*", "<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "privacy", "enabled": true, "path": "rules/privacy.json" },
      { "id": "frames", "enabled": false, "path": "rules/frames.json" }
    ]
  },
  "devtools_page": "devtools.html",
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_title": "Легко — економія ресурсів",
    "default_popup": "popup.html"
  },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["folders-edge.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["folders-panel.html"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true }],
  "side_panel": { "default_path": "folders-panel.html" },
  "commands": {
    "folders-panel": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "Відкрити папки збоку" },
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" } }
  },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'" }
}
