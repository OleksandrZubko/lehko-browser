diff --git a/components/omnibox/browser/keyboard_layout_fix.h b/components/omnibox/browser/keyboard_layout_fix.h
new file mode 100644
index 00000000..9fbacd9e
--- /dev/null
+++ b/components/omnibox/browser/keyboard_layout_fix.h
@@ -0,0 +1,223 @@
+// Copyright 2026 The Lehko Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_OMNIBOX_BROWSER_KEYBOARD_LAYOUT_FIX_H_
+#define COMPONENTS_OMNIBOX_BROWSER_KEYBOARD_LAYOUT_FIX_H_
+
+#include <algorithm>
+#include <iterator>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace omnibox {
+
+// Above the 1300 of the search for the text as typed, so that a converted site
+// leads the list and takes Enter.
+inline constexpr int kLeadingRelevance = 1350;
+
+// `c` in lower case, for Cyrillic letters only.
+inline char16_t LowerCyrillic(char16_t c) {
+  if (c >= u'А' && c <= u'Я') {
+    return c + (u'а' - u'А');
+  }
+  if (c == u'І' || c == u'Ї' || c == u'Є' || c == u'Ё') {
+    return c + 0x50;
+  }
+  return c == u'Ґ' ? u'ґ' : c;
+}
+
+// The Latin character on the same key of a Ukrainian or Russian keyboard, or 0.
+inline char16_t LatinOnSameKey(char16_t c) {
+  static constexpr char16_t kCyrillic[] =
+      u"йцукенгшщзхїъфівапролджєэячсмитьбюыґё";
+  static constexpr char16_t kLatin[] =
+      u"qwertyuiop[]]asdfghjkl;''zxcvbnm,.s``";
+  c = LowerCyrillic(c);
+  for (size_t i = 0; kCyrillic[i]; ++i) {
+    if (kCyrillic[i] == c) {
+      return kLatin[i];
+    }
+  }
+  return 0;
+}
+
+// The Ukrainian letter on the same key as a Latin character, or 0.
+inline char16_t UkrainianOnSameKey(char16_t c) {
+  static constexpr char16_t kLatin[] = u"qwertyuiop[]asdfghjkl;'zxcvbnm,.`";
+  static constexpr char16_t kUkrainian[] =
+      u"йцукенгшщзхїфівапролджєячсмитьбюґ";
+  if (c >= u'A' && c <= u'Z') {
+    c += u'a' - u'A';
+  }
+  for (size_t i = 0; kLatin[i]; ++i) {
+    if (kLatin[i] == c) {
+      return kUkrainian[i];
+    }
+  }
+  return 0;
+}
+
+// The same keys pressed in the other layout, both ways: `пщщпдуюсщь` gives
+// `google.com` and `yjdbyb` gives `новини`. Returns nothing for mixed text, for
+// fewer than two converted letters and for anything that already looks like a URL.
+inline std::optional<std::u16string> FixKeyboardLayout(
+    const std::u16string& text) {
+  std::u16string fixed = text;
+  size_t to_latin = 0, to_ukrainian = 0;
+  for (char16_t& c : fixed) {
+    if (const char16_t latin = LatinOnSameKey(c)) {
+      c = latin;
+      ++to_latin;
+    } else if (c > 0x7f) {
+      return std::nullopt;
+    } else if (c == u'/' || c == u':') {
+      return std::nullopt;
+    } else if ((c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z')) {
+      ++to_ukrainian;
+    }
+  }
+  if (to_latin >= 2 && to_ukrainian == 0) {
+    // On these keyboards the `/` key types a full stop, and `ю` is the dot.
+    for (size_t i = 0; i < fixed.size(); ++i) {
+      if (text[i] == u'.') {
+        fixed[i] = u'/';
+      }
+    }
+    return fixed;
+  }
+  if (to_latin == 0 && to_ukrainian >= 2) {
+    for (char16_t& c : fixed) {
+      if (const char16_t ukrainian = UkrainianOnSameKey(c)) {
+        c = ukrainian;
+      }
+    }
+    return fixed;
+  }
+  return std::nullopt;
+}
+
+// Whether converted text reads like words rather than key noise, so that a typed
+// English query does not also offer `руддщ` and the like. Only letters, spaces and
+// digits, and a vowel. Latin: no 4 consonants in a row. Cyrillic: the same, 3 only
+// without the letters that English vowels turn into, no 3 vowels in a row, and no
+// `ь` at a word start or after a vowel.
+inline bool LooksLikeWords(const std::u16string& fixed) {
+  static constexpr std::u16string_view kVowels = u"aeiouyаеєиіїоуюя";
+  static constexpr std::u16string_view kNoisy = u"щфш";
+  size_t letters = 0, consonants = 0, vowels = 0, noisy_letters = 0;
+  bool any_vowel = false, noisy = false, word_start = true;
+  for (const char16_t c : fixed) {
+    const bool is_latin = c >= u'a' && c <= u'z';
+    const bool is_cyrillic = c > 0x7f;
+    if (!is_latin && !is_cyrillic) {
+      if (c != u' ' && (c < u'0' || c > u'9')) {
+        return false;
+      }
+      consonants = vowels = 0;
+      noisy = false;
+      word_start = true;
+      continue;
+    }
+    ++letters;
+    if (c == u'ь') {
+      if (word_start || vowels > 0) {
+        return false;
+      }
+      word_start = false;
+      continue;
+    }
+    word_start = false;
+    if (kVowels.find(c) != std::u16string_view::npos) {
+      any_vowel = true;
+      consonants = 0;
+      noisy = false;
+      if (++vowels >= 3 && is_cyrillic) {
+        return false;
+      }
+    } else {
+      vowels = 0;
+      ++consonants;
+      if (kNoisy.find(c) != std::u16string_view::npos) {
+        noisy = true;
+        ++noisy_letters;
+      }
+      if (consonants >= 4 || (consonants == 3 && noisy)) {
+        return false;
+      }
+    }
+  }
+  return letters >= 3 && any_vowel && noisy_letters * 4 <= letters;
+}
+
+// The site that converted text names: a whole address such as `google.com/mail`,
+// or the start of a well-known site, at least 3 keys, so that a new profile with no
+// history still finds it. Only for text that converted to Latin.
+inline std::optional<std::string> SiteInFixedText(const std::u16string& fixed) {
+  static constexpr std::string_view kEndings[] = {
+      "com", "net", "org", "ua", "io", "dev", "app", "ai", "me", "tv", "co", "eu"};
+  static constexpr std::string_view kSites[] = {
+      "google.com",        "youtube.com",    "facebook.com",  "instagram.com",
+      "gmail.com",         "wikipedia.org",  "github.com",    "telegram.org",
+      "reddit.com",        "linkedin.com",   "netflix.com",   "amazon.com",
+      "twitch.tv",         "discord.com",    "spotify.com",   "tiktok.com",
+      "whatsapp.com",      "pinterest.com",  "chatgpt.com",   "claude.ai",
+      "stackoverflow.com", "aliexpress.com", "booking.com",   "figma.com",
+      "notion.so",         "monobank.ua",    "privat24.ua",   "rozetka.com.ua",
+      "olx.ua",            "prom.ua",        "pravda.com.ua", "ukr.net",
+      "dou.ua",            "novaposhta.ua",  "diia.gov.ua",   "hotline.ua"};
+  std::string ascii;
+  for (const char16_t c : fixed) {
+    if (!((c >= u'a' && c <= u'z') || (c >= u'0' && c <= u'9') || c == u'.' ||
+          c == u'-' || c == u'/')) {
+      return std::nullopt;
+    }
+    ascii.push_back(static_cast<char>(c));
+  }
+  const std::string_view host = std::string_view(ascii).substr(0, ascii.find('/'));
+  const size_t dot = host.rfind('.');
+  if (dot != std::string_view::npos && !host.starts_with('.') &&
+      host.find("..") == std::string_view::npos &&
+      std::ranges::find(kEndings, host.substr(dot + 1)) != std::end(kEndings)) {
+    return ascii;
+  }
+  if (ascii.size() >= 3 && host.size() == ascii.size()) {
+    for (const std::string_view site : kSites) {
+      if (site.starts_with(ascii)) {
+        return std::string(site);
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+// Whether what was typed reads like words as it stands, in which case a conversion
+// may be offered but must not take Enter.
+inline bool TypedTextIsWords(const std::u16string& text) {
+  std::u16string lower = text;
+  std::ranges::transform(lower, lower.begin(), LowerCyrillic);
+  return LooksLikeWords(lower);
+}
+
+// Whether `fixed` starts the site's host, as `goog` does for www.google.com.
+// Such a match may lead the list: a word that happens to convert to the start
+// of a visited host is rare, and anything shorter than 3 keys is too ambiguous.
+inline bool IsHostPrefix(std::string_view host, const std::u16string& fixed) {
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  if (fixed.size() < 3 || fixed.size() > host.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < fixed.size(); ++i) {
+    if (fixed[i] != static_cast<char16_t>(host[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace omnibox
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_KEYBOARD_LAYOUT_FIX_H_
