diff --git a/components/omnibox/browser/keyboard_layout_fix.h b/components/omnibox/browser/keyboard_layout_fix.h
new file mode 100644
index 00000000..e1092f87
--- /dev/null
+++ b/components/omnibox/browser/keyboard_layout_fix.h
@@ -0,0 +1,75 @@
+// Copyright 2026 The Lehko Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_OMNIBOX_BROWSER_KEYBOARD_LAYOUT_FIX_H_
+#define COMPONENTS_OMNIBOX_BROWSER_KEYBOARD_LAYOUT_FIX_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace omnibox {
+
+// The Latin character on the same key of a Ukrainian or Russian keyboard, or 0.
+inline char16_t LatinOnSameKey(char16_t c) {
+  static constexpr char16_t kCyrillic[] =
+      u"йцукенгшщзхїъфівапролджєэячсмитьбюыґё";
+  static constexpr char16_t kLatin[] =
+      u"qwertyuiop[]]asdfghjkl;''zxcvbnm,.s``";
+  if (c >= u'А' && c <= u'Я') {
+    c += u'а' - u'А';
+  } else if (c == u'І' || c == u'Ї' || c == u'Є' || c == u'Ё') {
+    c += 0x50;
+  } else if (c == u'Ґ') {
+    c = u'ґ';
+  }
+  for (size_t i = 0; kCyrillic[i]; ++i) {
+    if (kCyrillic[i] == c) {
+      return kLatin[i];
+    }
+  }
+  return 0;
+}
+
+// `пщщпдуюсщь` -> `google.com`: the same keys pressed in the wrong layout.
+// Returns nothing unless the text has at least two letters to convert.
+inline std::optional<std::u16string> FixKeyboardLayout(
+    const std::u16string& text) {
+  std::u16string fixed = text;
+  size_t converted = 0;
+  for (char16_t& c : fixed) {
+    if (const char16_t latin = LatinOnSameKey(c)) {
+      c = latin;
+      ++converted;
+    } else if (c > 0x7f) {
+      return std::nullopt;
+    }
+  }
+  if (converted < 2) {
+    return std::nullopt;
+  }
+  return fixed;
+}
+
+// Whether `fixed` starts the site's host, as `goog` does for www.google.com.
+// Such a match may lead the list: a word that happens to convert to the start
+// of a visited host is rare, and anything shorter than 3 keys is too ambiguous.
+inline bool IsHostPrefix(std::string_view host, const std::u16string& fixed) {
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  if (fixed.size() < 3 || fixed.size() > host.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < fixed.size(); ++i) {
+    if (fixed[i] != static_cast<char16_t>(host[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace omnibox
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_KEYBOARD_LAYOUT_FIX_H_
