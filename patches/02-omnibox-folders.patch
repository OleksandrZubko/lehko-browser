+
+struct FolderItem {
+  std::string id;
+  std::string name;
+  std::vector<FolderTabEntry> tabs;
+};
+
+// FolderPickerView displays a clickable folder icon and label on the leading
+// (left) side of the location bar, allowing users to switch between tab folders.
+class FolderPickerView : public IconLabelBubbleView,
+                         public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(FolderPickerView, IconLabelBubbleView)
+
+ public:
+  FolderPickerView(const gfx::FontList& font_list,
+                   IconLabelBubbleView::Delegate* parent_delegate,
+                   BrowserWindowInterface* browser,
+                   Profile* profile);
+  FolderPickerView(const FolderPickerView&) = delete;
+  FolderPickerView& operator=(const FolderPickerView&) = delete;
+  ~FolderPickerView() override;
+
+  void Update();
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+
+ private:
+  void OnButtonPressed();
+  void SwitchToFolder(size_t target_index);
+  void CreateNewFolder();
+  void MoveActiveTabToFolder(size_t target_index);
+  void DeleteCurrentFolder();
+
+  void LoadFoldersFromDisk();
+  void SaveFoldersToDisk();
+  void SaveCurrentFolderTabs();
+
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  raw_ptr<Profile> profile_ = nullptr;
+
+  std::vector<FolderItem> folders_;
+  std::string active_folder_id_;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<ui::SimpleMenuModel> move_submenu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_FOLDER_PICKER_VIEW_H_
