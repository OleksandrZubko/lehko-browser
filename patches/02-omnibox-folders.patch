+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+
+namespace {
+
+constexpr int kCommandFolderBase = 1000;
+constexpr int kCommandMoveToBase = 2000;
+constexpr int kCommandNewFolder = 3001;
+constexpr int kCommandDeleteFolder = 3002;
+constexpr int kCommandMoveSubmenu = 3003;
+
+}  // namespace
+
+FolderPickerView::FolderPickerView(
+    const gfx::FontList& font_list,
+    IconLabelBubbleView::Delegate* parent_delegate,
+    BrowserWindowInterface* browser,
+    Profile* profile)
+    : IconLabelBubbleView(font_list, parent_delegate),
+      browser_(browser),
+      profile_(profile) {
+  SetImageModel(ui::ImageModel::FromVectorIcon(
+      vector_icons::kFolderOpenIcon, ui::kColorIcon, 16));
+  SetBackgroundVisibility(BackgroundVisibility::kAlways);
+  SetCallback(base::BindRepeating(&FolderPickerView::OnButtonPressed,
+                                  base::Unretained(this)));
+  LoadFoldersFromDisk();
+  Update();
+}
+
+FolderPickerView::~FolderPickerView() {
+  SaveCurrentFolderTabs();
+}
+
+void FolderPickerView::LoadFoldersFromDisk() {
+  if (!profile_) {
+    return;
+  }
+  base::FilePath path = profile_->GetPath().AppendASCII("lehko_folders.json");
+  std::string json_data;
+  if (!base::ReadFileToString(path, &json_data)) {
+    FolderItem default_folder;
+    default_folder.id = "main";
+    default_folder.name = "Основна";
+    folders_.push_back(default_folder);
+    active_folder_id_ = "main";
+    SaveFoldersToDisk();
+    return;
+  }
+
+  auto parsed = base::JSONReader::Read(json_data);
+  if (!parsed || !parsed->is_dict()) {
+    FolderItem default_folder;
+    default_folder.id = "main";
+    default_folder.name = "Основна";
+    folders_.push_back(default_folder);
+    active_folder_id_ = "main";
+    SaveFoldersToDisk();
+    return;
+  }
+
+  const base::Value::Dict& root = parsed->GetDict();
+  if (const std::string* active_id = root.FindString("active_id")) {
+    active_folder_id_ = *active_id;
+  } else {
+    active_folder_id_ = "main";
+  }
+
+  folders_.clear();
+  if (const base::Value::List* list = root.FindList("folders")) {
+    for (const auto& item_val : *list) {
+      if (!item_val.is_dict()) {
+        continue;
+      }
+      const base::Value::Dict& f_dict = item_val.GetDict();
+      FolderItem folder;
+      if (const std::string* id = f_dict.FindString("id")) {
+        folder.id = *id;
+      }
+      if (const std::string* name = f_dict.FindString("name")) {
+        folder.name = *name;
+      }
+      if (const base::Value::List* tabs_list = f_dict.FindList("tabs")) {
+        for (const auto& t_val : *tabs_list) {
+          if (!t_val.is_dict()) {
+            continue;
+          }
+          const base::Value::Dict& t_dict = t_val.GetDict();
+          FolderTabEntry entry;
+          if (const std::string* url = t_dict.FindString("url")) {
+            entry.url = GURL(*url);
+          }
+          if (const std::string* title = t_dict.FindString("title")) {
+            entry.title = base::UTF8ToUTF16(*title);
+          }
+          if (entry.url.is_valid()) {
+            folder.tabs.push_back(entry);
+          }
+        }
+      }
+      folders_.push_back(folder);
+    }
+  }
+
+  if (folders_.empty()) {
+    FolderItem default_folder;
+    default_folder.id = "main";
+    default_folder.name = "Основна";
+    folders_.push_back(default_folder);
+    active_folder_id_ = "main";
+  }
+}
+
+void FolderPickerView::SaveFoldersToDisk() {
+  if (!profile_) {
+    return;
+  }
+  base::Value::Dict root;
+  root.Set("active_id", active_folder_id_);
+  base::Value::List list;
+  for (const auto& folder : folders_) {
+    base::Value::Dict f_dict;
+    f_dict.Set("id", folder.id);
+    f_dict.Set("name", folder.name);
+    base::Value::List tabs_list;
+    for (const auto& tab : folder.tabs) {
+      base::Value::Dict t_dict;
+      t_dict.Set("url", tab.url.spec());
+      t_dict.Set("title", base::UTF16ToUTF8(tab.title));
+      tabs_list.Append(std::move(t_dict));
+    }
+    f_dict.Set("tabs", std::move(tabs_list));
+    list.Append(std::move(f_dict));
+  }
+  root.Set("folders", std::move(list));
+
+  std::string json_str;
+  if (base::JSONWriter::WriteWithOptions(
+          root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json_str)) {
+    base::ImportantFileWriter::WriteFileAtomically(
+        profile_->GetPath().AppendASCII("lehko_folders.json"), json_str);
+  }
+}
+
+void FolderPickerView::SaveCurrentFolderTabs() {
+  if (!browser_) {
+    return;
+  }
+  TabStripModel* tab_strip = browser_->GetTabStripModel();
+  if (!tab_strip) {
+    return;
+  }
+
+  auto it = std::find_if(
+      folders_.begin(), folders_.end(),
+      [this](const FolderItem& f) { return f.id == active_folder_id_; });
+  if (it == folders_.end()) {
+    return;
+  }
+
+  it->tabs.clear();
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (tab_strip->IsTabPinned(i)) {
+      continue;
+    }
+    content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+    if (!contents) {
+      continue;
+    }
+    GURL url = contents->GetVisibleURL();
+    if (!url.is_valid() || url.spec().empty() || url.spec() == "about:blank") {
+      url = contents->GetLastCommittedURL();
+    }
+    if (!url.is_valid() || url.spec().empty()) {
+      url = GURL("chrome://newtab/");
+    }
+    std::u16string title = contents->GetTitle();
+    it->tabs.push_back({url, title});
+  }
+  SaveFoldersToDisk();
+}
+
+void FolderPickerView::Update() {
+  auto it = std::find_if(
+      folders_.begin(), folders_.end(),
+      [this](const FolderItem& f) { return f.id == active_folder_id_; });
+  std::string name = (it != folders_.end()) ? it->name : "Основна";
+  SetLabel(base::UTF8ToUTF16(name));
+  SetTooltipText(base::UTF8ToUTF16("Папка: " + name));
+  SetVisible(true);
+  ResetSlideAnimation(true);
+}
+
+void FolderPickerView::OnButtonPressed() {
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+
+  for (size_t i = 0; i < folders_.size(); ++i) {
+    int cmd = kCommandFolderBase + static_cast<int>(i);
+    std::string prefix = (folders_[i].id == active_folder_id_) ? "✓ " : "   ";
+    std::string count_str =
+        " (" + base::NumberToString(folders_[i].tabs.size()) + ")";
+    std::string label = prefix + folders_[i].name + count_str;
+    menu_model_->AddItem(cmd, base::UTF8ToUTF16(label));
+  }
+
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kCommandNewFolder, base::UTF8ToUTF16("+ Нова папка"));
+
+  if (folders_.size() > 1) {
+    move_submenu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    for (size_t i = 0; i < folders_.size(); ++i) {
+      if (folders_[i].id == active_folder_id_) {
+        continue;
+      }
+      int cmd = kCommandMoveToBase + static_cast<int>(i);
+      move_submenu_model_->AddItem(cmd, base::UTF8ToUTF16(folders_[i].name));
+    }
+    menu_model_->AddSubMenu(kCommandMoveSubmenu,
+                            base::UTF8ToUTF16("Перенести активну вкладку до…"),
+                            move_submenu_model_.get());
+
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItem(kCommandDeleteFolder,
+                         base::UTF8ToUTF16("Видалити поточну папку"));
+  }
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::COMBOBOX);
+
+  gfx::Rect anchor_bounds = GetBoundsInScreen();
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, anchor_bounds,
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+}
+
+void FolderPickerView::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id >= kCommandFolderBase &&
+      command_id < kCommandFolderBase + static_cast<int>(folders_.size())) {
+    size_t target_idx = static_cast<size_t>(command_id - kCommandFolderBase);
+    SwitchToFolder(target_idx);
+  } else if (command_id >= kCommandMoveToBase &&
+             command_id <
+                 kCommandMoveToBase + static_cast<int>(folders_.size())) {
+    size_t target_idx = static_cast<size_t>(command_id - kCommandMoveToBase);
+    MoveActiveTabToFolder(target_idx);
+  } else if (command_id == kCommandNewFolder) {
+    CreateNewFolder();
+  } else if (command_id == kCommandDeleteFolder) {
+    DeleteCurrentFolder();
+  }
+}
+
+bool FolderPickerView::IsCommandIdChecked(int command_id) const {
+  if (command_id >= kCommandFolderBase &&
+      command_id < kCommandFolderBase + static_cast<int>(folders_.size())) {
+    size_t idx = static_cast<size_t>(command_id - kCommandFolderBase);
+    return folders_[idx].id == active_folder_id_;
+  }
+  return false;
+}
+
+bool FolderPickerView::IsCommandIdEnabled(int command_id) const {
+  if (command_id == kCommandDeleteFolder) {
+    return folders_.size() > 1;
+  }
+  return true;
+}
+
+void FolderPickerView::SwitchToFolder(size_t target_index) {
+  if (target_index >= folders_.size()) {
+    return;
+  }
+  if (folders_[target_index].id == active_folder_id_) {
+    return;
+  }
+
+  SaveCurrentFolderTabs();
+
+  TabStripModel* tab_strip = browser_ ? browser_->GetTabStripModel() : nullptr;
+  if (!tab_strip) {
+    return;
+  }
+
+  std::vector<int> tabs_to_close;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (!tab_strip->IsTabPinned(i)) {
+      tabs_to_close.push_back(i);
+    }
+  }
+
+  active_folder_id_ = folders_[target_index].id;
+  SaveFoldersToDisk();
+
+  const auto& target_tabs = folders_[target_index].tabs;
+  if (target_tabs.empty()) {
+    browser_->OpenGURL(GURL("chrome://newtab/"),
+                      WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  } else {
+    for (size_t i = 0; i < target_tabs.size(); ++i) {
+      WindowOpenDisposition disp = (i == 0)
+                                       ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                                       : WindowOpenDisposition::NEW_BACKGROUND_TAB;
+      browser_->OpenGURL(target_tabs[i].url, disp);
+    }
+  }
+
+  for (auto it = tabs_to_close.rbegin(); it != tabs_to_close.rend(); ++it) {
+    tab_strip->CloseWebContentsAt(*it, TabCloseTypes::CLOSE_USER_GESTURE);
+  }
+
+  Update();
+}
+
+void FolderPickerView::CreateNewFolder() {
+  SaveCurrentFolderTabs();
+  size_t num = folders_.size() + 1;
+  std::string name = "Папка " + base::NumberToString(num);
+  std::string id =
+      base::NumberToString(base::Time::Now().InMillisecondsSinceUnixEpoch());
+  FolderItem new_f;
+  new_f.id = id;
+  new_f.name = name;
+  new_f.tabs.push_back({GURL("chrome://newtab/"), u"Нова вкладка"});
+  folders_.push_back(new_f);
+  SaveFoldersToDisk();
+  SwitchToFolder(folders_.size() - 1);
+}
+
+void FolderPickerView::MoveActiveTabToFolder(size_t target_index) {
+  if (target_index >= folders_.size()) {
+    return;
+  }
+  TabStripModel* tab_strip = browser_ ? browser_->GetTabStripModel() : nullptr;
+  if (!tab_strip) {
+    return;
+  }
+  int active_idx = tab_strip->active_index();
+  if (active_idx < 0 || tab_strip->IsTabPinned(active_idx)) {
+    return;
+  }
+
+  content::WebContents* contents = tab_strip->GetWebContentsAt(active_idx);
+  if (!contents) {
+    return;
+  }
+
+  GURL url = contents->GetVisibleURL();
+  if (!url.is_valid()) {
+    url = contents->GetLastCommittedURL();
+  }
+  if (!url.is_valid()) {
+    url = GURL("chrome://newtab/");
+  }
+  std::u16string title = contents->GetTitle();
+
+  folders_[target_index].tabs.push_back({url, title});
+
+  int non_pinned_count = 0;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    if (!tab_strip->IsTabPinned(i)) {
+      non_pinned_count++;
+    }
+  }
+  if (non_pinned_count <= 1) {
+    browser_->OpenGURL(GURL("chrome://newtab/"),
+                      WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  }
+
+  tab_strip->CloseWebContentsAt(active_idx, TabCloseTypes::CLOSE_USER_GESTURE);
+  SaveCurrentFolderTabs();
+  Update();
+}
+
+void FolderPickerView::DeleteCurrentFolder() {
+  if (folders_.size() <= 1) {
+    return;
+  }
+  auto it = std::find_if(
+      folders_.begin(), folders_.end(),
+      [this](const FolderItem& f) { return f.id == active_folder_id_; });
+  if (it == folders_.end()) {
+    return;
+  }
+  size_t cur_idx = std::distance(folders_.begin(), it);
+  size_t next_idx = (cur_idx == 0) ? 1 : (cur_idx - 1);
+  std::string next_id = folders_[next_idx].id;
+  folders_.erase(it);
+  active_folder_id_ = next_id;
+  SaveFoldersToDisk();
+
+  auto next_it = std::find_if(
+      folders_.begin(), folders_.end(),
+      [this](const FolderItem& f) { return f.id == active_folder_id_; });
+  if (next_it != folders_.end()) {
+    size_t target_idx = std::distance(folders_.begin(), next_it);
+    SwitchToFolder(target_idx);
+  }
+}
+
+BEGIN_METADATA(FolderPickerView)
+END_METADATA
