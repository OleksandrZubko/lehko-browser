# Lean Chromium GN Arguments for Apple Silicon (macOS arm64)
# Optimized for minimal RAM, CPU, and disk footprint

is_debug = false
is_official_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

target_os = "mac"
target_cpu = "arm64"

# Codecs: Support H.264/AAC/VP9 for web compatibility
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Strip bloat & background services
enable_nacl = false
enable_media_router = false

# Remove Google telemetry & client IDs
# Without an API key Safe Browsing gets no list updates, so the build has no protection
# against phishing/malware sites. Inject a key from a CI secret before daily use.
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Build flags
is_component_build = false
# Source tarballs ship without PGO profiles; official builds otherwise fail in gn gen.
chrome_pgo_phase = 0
# Official builds default to dSYMs, which need the dsymutil gclient hook (absent in tarballs).
enable_dsyms = false
treat_warnings_as_errors = false
